/*
====================================================
SEARCH API
====================================================
*/

app.get("/api/organizations/search", (req, res) => {

    const bloodGroup = req.query.bloodGroup;
    const location = req.query.location;

    console.log("--------------------------------");
    console.log("Blood Group:", bloodGroup);
    console.log("Location:", location);

    if (!bloodGroup || !location) {
        return res.status(400).json({
            success: false,
            message: "Blood group and location are required"
        });
    }

    const searchLocation = location.toLowerCase().trim();

    const results = bloodBanks
        .filter(bank => {

            const cityMatch =
                bank.city.toLowerCase().includes(searchLocation);

            const areaMatch =
                bank.area.toLowerCase().includes(searchLocation);

            return cityMatch || areaMatch;
        })
        .filter(bank => {

            return (
                bank.blood[bloodGroup] !== undefined &&
                bank.blood[bloodGroup] > 0
            );

        })
        .map(bank => {

            return {
                id: bank.id,
                name: bank.name,
                area: bank.area,
                city: bank.city,
                type: bank.type,
                phone: bank.phone,
                bloodGroup: bloodGroup,
                unitsAvailable: bank.blood[bloodGroup]
            };

        });

    console.log("Results:", results.length);

    res.json({
        success: true,
        count: results.length,
        results: results
    });
});

/*
====================================================
GET ALL BLOOD BANKS
====================================================
*/

app.get("/api/organizations", (req, res) => {

    res.json({
        success: true,
        count: bloodBanks.length,
        results: bloodBanks
    });

});

